# ─────────────────────────────────────────────────────────────────────────────
#  Reliance Bank — environment
#
#  Copy to `.env` and fill in. Config is validated by Zod at boot: a missing or
#  malformed variable aborts startup with a readable message rather than failing
#  later in a request. Never commit a real secret — a pre-commit scanner blocks it.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug

# --- Service URLs ------------------------------------------------------------
PORT=4400
TRUST_PROXY=false
API_URL=http://localhost:4400
WEB_MARKETING_URL=http://localhost:3000
WEB_CLIENT_URL=http://localhost:3001
WEB_ADMIN_URL=http://localhost:3002

# Host ports are non-default so Reliance Bank can run alongside other local stacks.
MONGO_PORT=27317
REDIS_PORT=6579

# --- Data --------------------------------------------------------------------
# The `replicaSet` parameter is required. Transactions do not exist without it.
MONGODB_URI=mongodb://localhost:27317/reliancebank?replicaSet=rs0
MONGODB_DB=reliancebank
REDIS_URL=redis://localhost:6579

# --- Auth --------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-48-bytes-of-base64-entropy
JWT_REFRESH_SECRET=replace-me-with-a-different-48-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
STEP_UP_TTL=5m

COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
CSRF_SECRET=replace-me-with-32-bytes-of-entropy

# Argon2id cost. Raise memory before raising time; these are the OWASP minimums.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# AES-256-GCM key for field-level encryption of PII. 32 bytes, base64.
ENCRYPTION_KEY=replace-me-with-32-bytes-base64

# --- Email — Resend ----------------------------------------------------------
# https://resend.com/api-keys · leave RESEND_API_KEY empty to log emails to stdout
# instead of sending, which is the default for local development.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_FROM="Reliance Bank <no-reply@reliancebank.example>"
MAIL_REPLY_TO=support@reliancebank.example

# --- Media — Cloudinary ------------------------------------------------------
# https://console.cloudinary.com/settings/api-keys
# KYC material is uploaded to a private folder and served only via signed URLs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=reliancebank/dev
CLOUDINARY_SIGNED_URL_TTL=300

# --- Web push ----------------------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@reliancebank.example

# --- Bank identity -----------------------------------------------------------
BANK_NAME="Reliance Bank"
BANK_CODE=RLNC
BANK_BIC=RLNCGB2LXXX
BANK_COUNTRY=GB
BANK_SORT_CODE=049921
BASE_CURRENCY=GBP
SUPPORTED_CURRENCIES=GBP,USD,EUR,NGN,GHS,KES,ZAR,JPY,CAD,AUD

# --- Simulation --------------------------------------------------------------
# The clock the whole application reads. Disable in any environment where a
# human might mistake simulated state for real state.
SIM_CLOCK_ENABLED=true
# Deterministic RNG seed — the same seed reproduces the same generated history.
SIM_SEED=reliance-2026
SIM_RAIL_FAILURE_BPS=300
SIM_RAIL_LATENCY_MIN_MS=250
SIM_RAIL_LATENCY_MAX_MS=2500

# --- Feature flags -----------------------------------------------------------
FEATURE_BUSINESS_BANKING=true
FEATURE_INVESTMENTS=false
FEATURE_PASSKEYS=true

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Observability -----------------------------------------------------------
SENTRY_DSN=
METRICS_ENABLED=true

# --- Front ends --------------------------------------------------------------
# Next reads env from its own app directory, so these are duplicated into
# apps/<app>/.env.local rather than inherited from here. Keep the two in step.
NEXT_PUBLIC_API_URL=http://localhost:4400/v1
NEXT_PUBLIC_BANK_NAME="Reliance Bank"
# Canonical origin of each front end. Each app resolves its own icon and Open Graph URLs
# against its own value; unset, Next resolves them against localhost and only warns, which
# ships share cards pointing at the build machine.
NEXT_PUBLIC_SITE_URL=https://www.reliancebank.example
NEXT_PUBLIC_APP_URL=https://app.reliancebank.example
NEXT_PUBLIC_CONSOLE_URL=https://operations.reliancebank.example
# Server-side override used by the admin console BFF. Set this to a private/internal API
# origin in deployment if the browser-facing NEXT_PUBLIC_API_URL differs.
API_ORIGIN=
# Server-side URL used only by the marketing site's public API client.
RELIANCE_PUBLIC_API_URL=
# Set to "1" to run any front end entirely against MSW mocks, with no API at all.
NEXT_PUBLIC_USE_MOCKS=0
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
