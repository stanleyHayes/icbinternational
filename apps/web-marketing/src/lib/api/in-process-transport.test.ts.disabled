// PARKED — rename to `in-process-transport.test.ts` once `jest.config.mjs` carries the
// `transform` + `transformIgnorePatterns` block from `packages/mocks/jest.config.mjs`.
// See docs/HANDOFFS.md. The suite is complete and was written against the code as it stands;
// it fails today only because msw's ESM-only transitive dependency is not transformed.

import { API_PREFIX, routes } from '@reliance/contracts';
import { resetMockDatabase } from '@reliance/mocks';

import { inProcessFetch } from './in-process-transport';

const SEED = 1234;
const OK = 200;
const NOT_FOUND = 404;

function url(path: string): string {
  return `${API_PREFIX}${path}`;
}

beforeEach(() => {
  resetMockDatabase(SEED);
});

describe('the in-process transport', () => {
  it('answers a public GET with the contract envelope', async () => {
    const response = await inProcessFetch(url(routes.public.rates), { method: 'GET' });
    expect(response.status).toBe(OK);

    const body = (await response.json()) as { data: { savings: unknown[] } };
    expect(Array.isArray(body.data.savings)).toBe(true);
  });

  it('carries query parameters through to the handler', async () => {
    const response = await inProcessFetch(`${url(routes.public.faqs)}?limit=2`, { method: 'GET' });
    const body = (await response.json()) as { data: unknown[]; page: { limit: number } };

    expect(body.data).toHaveLength(2);
    expect(body.page.limit).toBe(2);
  });

  it('resolves a path parameter', async () => {
    const response = await inProcessFetch(url(routes.public.page('personal')), { method: 'GET' });
    const body = (await response.json()) as { data: { slug: string } };

    expect(body.data.slug).toBe('personal');
  });

  it('answers an unknown path with the contract error envelope, not a bare 404', async () => {
    const response = await inProcessFetch(url('/public/nothing-here'), { method: 'GET' });
    expect(response.status).toBe(NOT_FOUND);

    const body = (await response.json()) as { error: { code: string; message: string } };
    expect(body.error.code).toBe('NOT_FOUND');
    expect(body.error.message).toMatch(/not found/i);
  });

  it('posts a JSON body to the handler', async () => {
    const response = await inProcessFetch(url(routes.public.savingsCalculator), {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({
        initialDeposit: { amount: '200000', currency: 'GBP' },
        monthlyContribution: { amount: '20000', currency: 'GBP' },
        annualRateBps: 425,
        months: 12,
      }),
    });

    const body = (await response.json()) as { data: { finalBalance: { amount: string } } };

    // Integer minor units all the way through: the balance is a digit string, never a float.
    expect(body.data.finalBalance.amount).toMatch(/^\d+$/);
    expect(BigInt(body.data.finalBalance.amount)).toBeGreaterThan(200_000n + 240_000n);
  });

  it('is deterministic for a given seed', async () => {
    const first = await (await inProcessFetch(url(routes.public.fees), { method: 'GET' })).text();
    resetMockDatabase(SEED);
    const second = await (await inProcessFetch(url(routes.public.fees), { method: 'GET' })).text();

    expect(second).toBe(first);
  });
});
