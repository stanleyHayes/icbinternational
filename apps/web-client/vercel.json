{
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter @reliance/web-client... build",
  "outputDirectory": ".next",
  "rewrites": [
    {
      "source": "/api/bank/:path*",
      "destination": "/api/bank/:path*"
    }
  ]
}
