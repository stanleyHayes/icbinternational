{
  "name": "@reliance/api",
  "version": "1.0.0",
  "private": true,
  "description": "Reliance Bank core banking API \u2014 NestJS, MongoDB, double-entry ledger.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --enable-source-maps --env-file=../../.env dist/main.js)",
    "start": "node --enable-source-maps --env-file=../../.env dist/main.js",
    "clean": "rimraf dist coverage *.tsbuildinfo",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests --runInBand",
    "test:cov": "jest --coverage --runInBand",
    "test:watch": "jest --watch --runInBand",
    "seed": "node --env-file=../../.env dist/seed/run-seed.js",
    "demo:reset": "node --env-file=../../.env dist/seed/run-showcase.js",
    "ledger:verify": "node --env-file=../../.env dist/seed/verify-ledger.js",
    "audit:verify": "node --env-file=../../.env dist/modules/audit/verify-audit.command.js",
    "test:showcase": "RUN_SHOWCASE_TEST=1 jest src/seed/personas/__tests__/showcase.integration --coverage=false --runInBand",
    "start:prod": "node --enable-source-maps dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/mongoose": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/platform-ws": "11.1.28",
    "@nestjs/schedule": "catalog:",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/websockets": "11.1.28",
    "@reliance/contracts": "workspace:*",
    "@reliance/money": "workspace:*",
    "@simplewebauthn/server": "13.3.2",
    "argon2": "0.45.1",
    "cloudinary": "catalog:",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "date-fns": "catalog:",
    "helmet": "8.3.0",
    "mongoose": "catalog:",
    "otplib": "13.4.1",
    "pdfkit": "0.19.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "resend": "catalog:",
    "rxjs": "7.8.2",
    "ulid": "catalog:",
    "ws": "8.18.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "catalog:",
    "@reliance/config": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.5",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/pdfkit": "0.17.4",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "6.0.3",
    "@types/ws": "8.18.1",
    "eslint": "10.8.0",
    "jest": "catalog:",
    "rimraf": "6.0.1",
    "supertest": "catalog:",
    "typescript": "catalog:"
  }
}
