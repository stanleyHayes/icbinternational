{
  "name": "@reliance/mocks",
  "version": "1.0.0",
  "private": true,
  "description": "Stateful MSW handlers and seeded faker factories covering every route in the Reliance Bank contract.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "clean": "rimraf dist *.tsbuildinfo",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "jest --coverage --passWithNoTests"
  },
  "dependencies": {
    "@faker-js/faker": "catalog:",
    "@reliance/api-client": "workspace:*",
    "@reliance/contracts": "workspace:*",
    "@reliance/money": "workspace:*",
    "msw": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@reliance/config": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "eslint": "10.8.0",
    "jest": "catalog:",
    "rimraf": "6.0.1",
    "typescript": "catalog:"
  }
}
