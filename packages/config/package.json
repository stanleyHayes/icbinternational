{
  "name": "@reliance/config",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared TypeScript, ESLint and Prettier configuration for the Reliance Bank monorepo.",
  "exports": {
    "./eslint/base": "./eslint/base.js",
    "./eslint/nest": "./eslint/nest.js",
    "./eslint/next": "./eslint/next.js",
    "./eslint/react-library": "./eslint/react-library.js",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/nest.json": "./tsconfig/nest.json",
    "./tsconfig/next.json": "./tsconfig/next.json",
    "./tsconfig/node-library.json": "./tsconfig/node-library.json",
    "./tsconfig/react-library.json": "./tsconfig/react-library.json",
    "./jest/base": "./jest/base.mjs",
    "./eslint/plugin": "./eslint/plugin/index.js"
  },
  "files": [
    "eslint",
    "tsconfig",
    "jest"
  ],
  "scripts": {
    "lint": "echo 'config package: nothing to lint'",
    "typecheck": "echo 'config package: no TypeScript sources'",
    "test": "echo 'config package: no tests'",
    "test:cov": "echo 'config package: no tests'",
    "build": "echo 'config package: nothing to build'"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.2.12",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-unicorn": "72.0.0",
    "globals": "17.8.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.65.0"
  }
}
