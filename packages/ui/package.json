{
  "name": "@reliance/ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Reliance Bank design system: brand tokens, accessible primitives, composites and banking components.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tailwind-preset": "./tailwind-preset.ts",
    "./styles/theme.css": "./src/styles/theme.css",
    "./styles/tailwind-theme.css": "./src/styles/tailwind-theme.css"
  },
  "files": [
    "dist",
    "src/styles",
    "tailwind-preset.ts"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "theme": "node scripts/build-theme-css.mjs",
    "theme:check": "node scripts/build-theme-css.mjs --check",
    "build": "node scripts/build-theme-css.mjs && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "clean": "rimraf dist *.tsbuildinfo",
    "lint": "node scripts/build-theme-css.mjs --check && eslint src tailwind-preset.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@reliance/money": "workspace:*",
    "clsx": "2.1.1",
    "tailwind-merge": "3.3.1"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@reliance/config": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "catalog:",
    "@types/jest-axe": "3.5.9",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "10.8.0",
    "jest": "catalog:",
    "jest-axe": "10.0.0",
    "jest-environment-jsdom": "30.4.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rimraf": "6.0.1",
    "tailwindcss": "4.1.18",
    "typescript": "catalog:"
  }
}
